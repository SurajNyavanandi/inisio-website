# ==============================================================
# Inisio Unified Root .gitignore (Root, Backend, & Frontend)
# ==============================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
**/node_modules/

# Production Build Artifacts
dist/
**/dist/
dist-ssr/
build/
*.local
*.tsbuildinfo

# Environment & Secret Files (Keep secrets out of Git)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.crt

# Uploaded Files & Private Local Storage
uploads/
**/uploads/*
!**/uploads/.gitkeep
storage/private/*
!storage/private/.gitkeep

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Cache & Temporary Directories
.vite/
**/.vite/
**/.vite-temp/
.eslintcache
